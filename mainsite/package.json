{
  "name": "mainsite",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch --coverage",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:playwright:ui": "playwright test --ui",
    "release": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release && git push --follow-tags",
    "release:major": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --major && git push --follow-tags",
    "release:minor": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --minor && git push --follow-tags",
    "release:patch": "pnpm run lint & pnpm run test && pnpm run build && changelogen --release --patch && git push --follow-tags",
    "playwright:install": "playwright install --with-deps",
    "cleanup": "nuxt cleanup && rm -rf .nuxt .output dist node_modules/.cache",
    "lint": "oxlint lint .",
    "lint:eslint": "eslint . --ext .ts,.vue",
    "fix": "oxlint fix ."
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/seo": "6.0.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "@iconify-json/simple-icons": "^1.2.101",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/image": "2.2.1",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/test-utils": "4.3.4",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/ngrok": "4.0.0",
    "@pinia/nuxt": "1.0.3",
    "@playwright/test": "^1.65.0",
    "@takumi-rs/core": "^2.19.0",
    "@takumi-rs/wasm": "^2.19.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/components": "^15.0.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/math": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "@vueuse/nuxt": "15.0.0",
    "@vueuse/sound": "^2.1.3",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright-core": "^1.65.0",
    "tw-animate": "^1.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.18.0"
}
